# Copy this file to .env and fill in your own values. Never commit .env.

# brapi.dev token for B3 quotes (free plan available at https://brapi.dev).
# Without it, only the test tickers PETR4, MGLU3, VALE3 and ITUB4 are quoted.
BRAPI_TOKEN=

# Finnhub API key for US stocks and ETFs (free at https://finnhub.io).
FINNHUB_TOKEN=

# Optional: where to keep the database (default: your user data folder).
# WEALTHFORGE_DB=C:\Users\you\Documents\wealthforge.db
